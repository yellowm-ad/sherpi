{
  "name": "sherpy",
  "version": "0.1.0",
  "private": true,
  "description": "셰르피 산책지원 플랫폼 — 강아지를 자유롭게",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
